generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  displayName   String
  avatarKey     String?
  role          String   @default("user")
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime?

  refreshTokens        RefreshToken[]
  pushTokens           PushToken[]
  trackingSessions     TrackingSession[]
  trackingSessionViews TrackingSessionViewer[]
  conversationMembers  ConversationMember[]
  messages             Message[]
  attachments          Attachment[]
  notifications        Notification[]
  initiatedCalls       Call[]                @relation("CallInitiator")
  callParticipants     CallParticipant[]
  documentVersions     DocumentVersion[]

  announcementsAuthored      Announcement[]        @relation("AnnouncementAuthor")
  announcementsBroadcasting  Announcement[]        @relation("AnnouncementBroadcaster")
  announcementInvites        AnnouncementInvite[]  @relation("AnnouncementInvitee")
  liveStreamRequestsMade     LiveStreamRequest[]   @relation("LiveStreamRequester")
  liveStreamRequestsReviewed LiveStreamRequest[]   @relation("LiveStreamReviewer")
  liveStreamsBroadcast       LiveStreamSession[]    @relation("LiveBroadcaster")
  liveStreamViewerships      LiveStreamViewer[]     @relation("LiveViewer")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Conversation {
  id        String   @id @default(uuid())
  type      String   // 'direct' | 'group'
  name      String?
  createdAt DateTime @default(now())

  members     ConversationMember[]
  messages    Message[]
  attachments Attachment[]

  @@map("conversations")
}

model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  eventId        String   @unique
  status         String   @default("sent") // sent | delivered | read
  attachmentId   String?  @unique
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  attachment   Attachment?  @relation(fields: [attachmentId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    // info | success | warning | error
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Document {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocumentVersion[]

  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([documentId, createdAt])
  @@map("document_versions")
}

model TrackingSession {
  id        String    @id @default(uuid())
  userId    String
  consentAt DateTime
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  locations TrackingLocation[]
  viewers   TrackingSessionViewer[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tracking_sessions")
}

model TrackingSessionViewer {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  addedAt   DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("tracking_session_viewers")
}

model TrackingLocation {
  id         String   @id @default(uuid())
  sessionId  String
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, recordedAt])
  @@map("tracking_locations")
}

model PushToken {
  id           String   @id @default(uuid())
  userId       String
  platform     String   // 'fcm' | 'apns' | 'web'
  token        String   @unique
  subscription Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Call {
  id          String    @id @default(uuid())
  type        String    // 'audio' | 'video' | 'group'
  status      String    // 'ringing' | 'active' | 'ended' | 'missed' | 'rejected'
  initiatorId String
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  initiator    User              @relation("CallInitiator", fields: [initiatorId], references: [id])
  participants CallParticipant[]
  events       CallEvent[]

  @@map("calls")
}

model CallParticipant {
  id       String    @id @default(uuid())
  callId   String
  userId   String
  joinedAt DateTime?
  leftAt   DateTime?
  role     String    @default("callee") // caller | callee

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@map("call_participants")
}

model CallEvent {
  id        String   @id @default(uuid())
  callId    String
  type      String   // ringing | accept | reject | end | ice-candidate | sdp-offer | sdp-answer
  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
  @@map("call_events")
}

model Announcement {
  id            String    @id @default(uuid())
  authorId      String
  broadcasterId String?
  kind          String    @default("general") // 'general' | 'livestream'
  title         String
  body          String
  audience      String // 'everyone' | 'invited'
  status        String    @default("published") // 'published' | 'scheduled' | 'live' | 'ended' | 'cancelled'
  scheduledAt   DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author      User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  broadcaster User?                @relation("AnnouncementBroadcaster", fields: [broadcasterId], references: [id])
  invites     AnnouncementInvite[]
  request     LiveStreamRequest?
  liveSession LiveStreamSession?

  @@index([status, scheduledAt])
  @@map("announcements")
}

model AnnouncementInvite {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementInvitee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_invites")
}

model LiveStreamRequest {
  id             String    @id @default(uuid())
  requesterId    String
  title          String
  description    String
  proposedAt     DateTime?
  status         String    @default("pending") // 'pending' | 'approved' | 'rejected'
  announcementId String?   @unique
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  requester    User          @relation("LiveStreamRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("LiveStreamReviewer", fields: [reviewedById], references: [id])
  announcement Announcement? @relation(fields: [announcementId], references: [id])

  @@index([status])
  @@map("livestream_requests")
}

model LiveStreamSession {
  id             String    @id @default(uuid())
  announcementId String    @unique
  broadcasterId  String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  announcement Announcement       @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  broadcaster  User               @relation("LiveBroadcaster", fields: [broadcasterId], references: [id])
  viewers      LiveStreamViewer[]

  @@map("livestream_sessions")
}

model LiveStreamViewer {
  id        String    @id @default(uuid())
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  session LiveStreamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation("LiveViewer", fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("livestream_viewers")
}

model Attachment {
  id             String   @id @default(uuid())
  uploaderId     String
  conversationId String
  bucket         String
  key            String
  mimeType       String
  size           Int
  fileName       String
  createdAt      DateTime @default(now())

  uploader     User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?

  @@index([conversationId])
  @@index([uploaderId])
  @@map("attachments")
}
